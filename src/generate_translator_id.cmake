# KYTY_TRANSLATOR_ID: a hash of what the shader translation depends on — the translator's and the pipeline cache's
# sources (the set tools/local/deck/build-deck.sh hashes for the Steam Deck), the guest GPU's register and format
# definitions and the resource-plan helpers they use, the SPIR-V submodules' revisions, the compiler and the build's
# options. The shader prefetch cache keys on it (pipelineCache.cpp, PrefetchCacheKey) in place of the executable's
# revision, size and time: an update that leaves all of these alone keeps the translated programs (20,000 for Demon's
# Souls: minutes of two busy cores after every update otherwise). Run at every build (cmake -P); the header is written only
# when the id changes, so nothing recompiles otherwise.
# In: SOURCE_DIR (src), ROOT_DIR (the repository), OUTPUT_FILE, SALT (the compiler and build options), GIT_EXECUTABLE.

file(GLOB_RECURSE kyty_translator_files LIST_DIRECTORIES false RELATIVE "${SOURCE_DIR}"
	"${SOURCE_DIR}/graphics/shader/*.cpp" "${SOURCE_DIR}/graphics/shader/*.h" "${SOURCE_DIR}/graphics/shader/*.inc"
	"${SOURCE_DIR}/graphics/host_gpu/renderer/pipeline/*.cpp" "${SOURCE_DIR}/graphics/host_gpu/renderer/pipeline/*.h"
	"${SOURCE_DIR}/graphics/host_gpu/renderer/pipeline/*.inc")
list(APPEND kyty_translator_files
	graphics/guest_gpu/gpu_defs.h
	graphics/guest_gpu/gpu_format.h
	graphics/guest_gpu/hardwareContext.h
	local/native-preparation-scratch.h
	local/native-preparation-state.h
	local/native-resource-runtime.h
	local/native-resource-state.h
	local/resource-plan-serial.cpp
	local/resource-plan-serial.h
	local/shader-warmup-cache.h)
list(SORT kyty_translator_files)
list(REMOVE_DUPLICATES kyty_translator_files)

# Bump to drop every translator cache made before (a translation input this list misses changed).
set(kyty_translator_text "translator-id 1\n${SALT}\n")
foreach(file IN LISTS kyty_translator_files)
	if(EXISTS "${SOURCE_DIR}/${file}")
		file(SHA256 "${SOURCE_DIR}/${file}" file_hash)
	else()
		set(file_hash "missing")
	endif()
	string(APPEND kyty_translator_text "${file} ${file_hash}\n")
endforeach()

if(GIT_EXECUTABLE)
	foreach(module 3rdparty/SPIRV-Tools 3rdparty/SPIRV-Headers)
		execute_process(
			COMMAND "${GIT_EXECUTABLE}" ls-tree HEAD "${module}"
			WORKING_DIRECTORY "${ROOT_DIR}"
			OUTPUT_VARIABLE module_entry
			OUTPUT_STRIP_TRAILING_WHITESPACE
			RESULT_VARIABLE module_result
			ERROR_QUIET)
		if(NOT module_result EQUAL 0)
			set(module_entry "unknown")
		endif()
		string(APPEND kyty_translator_text "${module} ${module_entry}\n")
	endforeach()
endif()

string(SHA256 kyty_translator_hash "${kyty_translator_text}")
string(SUBSTRING "${kyty_translator_hash}" 0 24 KYTY_TRANSLATOR_ID)

set(kyty_translator_header "// Generated by generate_translator_id.cmake.\n#pragma once\n#define KYTY_TRANSLATOR_ID \"${KYTY_TRANSLATOR_ID}\"\n")
set(kyty_translator_old "")
if(EXISTS "${OUTPUT_FILE}")
	file(READ "${OUTPUT_FILE}" kyty_translator_old)
endif()
if(NOT kyty_translator_old STREQUAL kyty_translator_header)
	file(WRITE "${OUTPUT_FILE}" "${kyty_translator_header}")
endif()
